generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String     @id @default(uuid())
  name      String
  email     String     @unique
  avatar    String?
  googleId  String     @unique
  createdAt DateTime   @default(now())
  emailJobs EmailJob[]
}

model EmailJob {
  id             String    @id @default(uuid())
  recipientEmail String
  subject        String
  body           String    @db.Text
  scheduledTime  DateTime
  sentTime       DateTime?
  status         String    @default("scheduled") // scheduled, queued, sent, failed
  senderId       String
  sender         User      @relation(fields: [senderId], references: [id])
  retryCount     Int       @default(0)
  bullmqJobId    String?   @unique
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([status])
  @@index([scheduledTime])
  @@index([senderId])
}
